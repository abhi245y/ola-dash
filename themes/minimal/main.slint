// Minimal example theme. Proves a theme swaps in at runtime with no rebuild.
// Uses bundled Noto Sans SemiCondensed, draws nothing in the top 48px host bar.
import { Vehicle, Media, Actions, DriveMode, Plugins, VehicleState, Display } from "vehicle.slint";
import "fonts/NotoSans-SemiCondensed.ttf";
import "fonts/NotoSans-SemiCondensedBold.ttf";
// Re-exported so the host can reach the globals on the instance.
export { Vehicle, Media, Actions, DriveMode, Plugins }

export component Dash inherits Window {
    width: 1280px;
    height: 768px;
    background: root.ground;
    default-font-family: "Noto Sans SemiCondensed";

    property <color> ground: Display.night ? #000000 : #F6F3EC;
    property <color> ink: Display.night ? #ffffff : #0F2A2A;
    property <color> secondary: Display.night ? #b0b0b0 : #4A5C5C;
    property <color> media-secondary: Display.night ? #888 : #4A5C5C;
    property <color> button: Display.night ? #2a2a2a : #DBD4C3;
    property <color> card: Display.night ? #1a1a1a : #DBD4C3;
    property <color> disabled: Display.night ? #999999 : #4A5C5C;

    property <bool> trunk-enabled: Vehicle.state == VehicleState.park && Vehicle.speed-kmh == 0 && !Vehicle.trunk-open;

    // Parked (unlocked, not ready): show P and how to start. Charging also reports park mode.
    property <bool> parked: !Vehicle.charging && (Vehicle.state == VehicleState.park || Vehicle.mode == DriveMode.park);
    property <string> mode-name: Vehicle.mode == DriveMode.eco ? "ECO"
        : Vehicle.mode == DriveMode.normal ? "NORMAL"
        : Vehicle.mode == DriveMode.sport ? "SPORT"
        : Vehicle.mode == DriveMode.hyper ? "HYPER" : "--";

    // Content area starts below the host bar.
    Rectangle {
        y: 48px;
        width: parent.width;
        height: parent.height - 48px;

        Text {
            x: 0px;
            y: 110px;
            width: parent.width;
            horizontal-alignment: center;
            text: parked ? "P" : round(Vehicle.speed-kmh) + "";
            color: root.ink;
            font-size: 240px;
            font-weight: 700;
        }
        Text {
            x: 0px;
            y: 370px;
            width: parent.width;
            horizontal-alignment: center;
            text: parked ? "Press the power button to start" : "km/h   " + mode-name;
            color: root.secondary;
            font-size: 36px;
        }
        Text {
            x: 40px;
            y: 450px;
            text: (Vehicle.battery-pct < 0 ? "--" : "" + Vehicle.battery-pct + "%") + "   "
                + (Vehicle.range-km < 0 ? "--" : "" + Vehicle.range-km) + " km"
                + (Vehicle.charging ? "  charging" : "");
            color: root.ink;
            font-size: 48px;
        }
        Text {
            x: 40px;
            y: 520px;
            text: (Vehicle.left-indicator ? "<  " : "") + "trip " + round(Vehicle.trip-km) + " km" + (Vehicle.right-indicator ? "  >" : "");
            color: root.ink;
            font-size: 36px;
        }
        Text {
            x: parent.width - 320px;
            y: 20px;
            width: 300px;
            horizontal-alignment: right;
            text: Vehicle.clock-text;
            color: root.ink;
            font-size: 40px;
        }

        // First plugin widget, if any (see docs/plugins.md).
        if Plugins.widgets.length > 0 : Text {
            x: 480px;
            y: 36px;
            width: 400px;
            text: Plugins.widgets[0].title + " " + Plugins.widgets[0].value + " " + Plugins.widgets[0].unit;
            color: root.ink;
            font-size: 30px;
            overflow: elide;
        }

        // Trunk: enabled only parked and stopped; "Trunk open" is passive.
        Rectangle {
            x: 260px; y: 20px; width: 200px; height: 64px;
            background: root.button; border-radius: 12px;
            Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: Vehicle.trunk-open ? "Trunk open" : "Open trunk"; color: Vehicle.trunk-open || root.trunk-enabled ? root.ink : root.disabled; font-size: 26px; }
            TouchArea {
                enabled: root.trunk-enabled;
                clicked => { Actions.open-trunk(); }
            }
        }
        Rectangle {
            x: 40px; y: 20px; width: 200px; height: 64px;
            background: root.button; border-radius: 12px;
            Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "Settings"; color: root.ink; font-size: 26px; }
            TouchArea { clicked => { Actions.open-settings(); } }
        }

        // Media row
        Rectangle {
            x: 40px; y: 600px; width: 520px; height: 120px;
            background: root.card;
            border-radius: 12px;
            Text { x: 24px; y: 16px; text: Media.title; color: root.ink; font-size: 30px; }
            Text { x: 24px; y: 60px; text: Media.artist; color: root.media-secondary; font-size: 24px; }
        }
        Rectangle {
            x: 580px; y: 600px; width: 160px; height: 120px;
            background: root.button; border-radius: 12px;
            Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: Media.playing ? "Pause" : "Play"; color: root.ink; font-size: 30px; }
            TouchArea { clicked => { Media.play-pause(); } }
        }
        Rectangle {
            x: 760px; y: 600px; width: 160px; height: 120px;
            background: root.button; border-radius: 12px;
            Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "Next"; color: root.ink; font-size: 30px; }
            TouchArea { clicked => { Media.next(); } }
        }
        Rectangle {
            x: 940px; y: 600px; width: 300px; height: 120px;
            background: root.button; border-radius: 12px;
            Text { width: parent.width; height: parent.height; horizontal-alignment: center; vertical-alignment: center; text: "Android Auto"; color: root.ink; font-size: 30px; }
            TouchArea { clicked => { Actions.open-android-auto(); } }
        }
    }
}
